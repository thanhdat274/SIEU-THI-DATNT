{
  "name": "@game/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/bootstrap.ts",
    "start": "tsx src/bootstrap.ts",
    "verify:runtime": "tsx src/verify-runtime.ts",
    "test:worlds": "tsx src/world.repository.test.ts",
    "test:gateway": "tsx src/world.gateway.test.ts",
    "test:coop": "tsx src/coop-commands.test.ts",
    "test:invariants": "tsx src/save-invariants.test.ts",
    "test:ratelimit": "tsx src/rate-limit.test.ts",
    "test:unit": "yarn test:invariants && yarn test:ratelimit",
    "test:db": "yarn test:worlds && yarn test:gateway && yarn test:coop",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@game/core": "*",
    "@game/data": "*",
    "@game/shared": "*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/platform-ws": "12.1.2",
    "@nestjs/websockets": "12.1.2",
    "dotenv": "^18",
    "firebase-admin": "14.5.0",
    "mongodb": "7.7.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/ws": "^8.18.1",
    "@typescript/native": "npm:typescript@^7.0.2"
  }
}
