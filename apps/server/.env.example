# Copy to apps/server/.env. Existing shell environment takes priority.
HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=http://localhost:5173
# Một MongoDB đơn (local mongod hoặc Atlas free), không cần replica set/transaction.
# Ví dụ local: mongodb://127.0.0.1:27017
MONGO_URI=
MONGODB_DATABASE=sieu_thi_datnt_dev
# Firebase Auth (optional for local dev-guest testing; required for real Google login)
FIREBASE_PROJECT_ID=
# Firebase Console -> Project settings -> Service accounts -> Generate new private key.
# Copy client_email and private_key from that JSON. Keep both server-side only.
# In a .env file, quote the value and retain literal \n escapes in the private key.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Legacy local fallback only; remove after migrating an existing local setup.
# GOOGLE_APPLICATION_CREDENTIALS=
# For LOCAL 2-client / voice testing only (NEVER set in production):
#   GOOGLE_AUTH_BYPASS=true  -> skip Firebase verification; client sends X-Dev-Client-Id
#                              (via the dev-guest login in LoginScreen) to get a STABLE
#                              guest account guest_<id> so two browsers can share one alley.
#   Without X-Dev-Client-Id it falls back to a random guest per request (old behavior).
GOOGLE_AUTH_BYPASS=false
